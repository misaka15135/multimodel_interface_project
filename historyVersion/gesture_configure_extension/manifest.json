{
  "manifest_version": 3,
  "name": "AI 手势网页控制",
  "version": "1.0",
  "description": "使用手势（比2向上，比3向下）控制网页滚动",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["ges_con.css"],
      "js": ["ges_con.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}