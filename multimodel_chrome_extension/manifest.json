{
    "manifest_version": 3,
    "name": "Multimodel Control Extension",
    "version": "1.0",
    "description": "集成了手势与头部追踪以及语音控制的混合控制扩展",
    "permissions": [
        "activeTab"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "content.css"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle",
            "world": "MAIN"
        }
    ],
    "action": {
        "default_title": "混合控制增强"
    }
}