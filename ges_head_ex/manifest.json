{
    "manifest_version": 3,
    "name": "Hybrid Gesture & Head Control",
    "version": "3.0",
    "description": "集成了手势与头部追踪的混合控制扩展，V字手势切换模式，支持头部偏航控制视频进度。",
    "permissions": [
        "activeTab"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "content.css"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle",
            "world": "MAIN"
        }
    ],
    "action": {
        "default_title": "混合控制增强"
    }
}