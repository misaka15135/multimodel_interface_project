{
    "manifest_version": 3,
    "name": "声控助手",
    "version": "1.0.0",
    "description": "语音控制浏览器：混合意图引擎(本地优先+LLM兜底)、上下文记忆(追问/撤销/重复)、危险动作确认，多模态融合就绪(语音+手势+眼动)。",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "content.css"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}