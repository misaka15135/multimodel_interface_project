{
  "manifest_version": 3,
  "name": "声控助手",
  "version": "0.4.0",
  "description": "语音控制浏览器：混合意图引擎(本地优先+LLM兜底)、上下文记忆(追问/撤销/重复)、危险动作确认，多模态融合就绪(语音+手势+眼动)。",
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["voice-content.css"],
      "js": [
        "mmfusion-bus.js",
        "event-bus.js",
        "action-registry.js",
        "intent-matcher.js",
        "llm-client.js",
        "speech-recognizer.js",
        "tts-manager.js",
        "action-executor.js",
        "context-manager.js",
        "ui-manager.js",
        "voice-controller.js"
      ]
    }
  ]
}
