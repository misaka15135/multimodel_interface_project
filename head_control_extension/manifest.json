{
    "manifest_version": 3,
    "name": "Head Control Ultimate",
    "version": "1.0",
    "description": "全局自启动，带有悬浮预览面板与动作状态反馈的头部滚动增强插件。",
    "permissions": [
        "activeTab"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "head_content.css"
            ],
            "js": [
                "head_content.js"
            ],
            "run_at": "document_idle",
            "world": "MAIN"
        }
    ],
    "action": {
        "default_title": "头部控制增强"
    }
}