{
  "manifest_version": 3,
  "name": "Eye Control",
  "version": "0.1.0",
  "description": "Eye tracking browser control powered by MediaPipe Face Landmarker.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "videoCapture",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Eye Control"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
